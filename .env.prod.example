# Copy to .env.prod and fill in values before: docker compose build

VITE_APP_ENV=production
# Public URL where this container is served (browser must reach this)
VITE_API_URL=http://172.174.201.208:8080
VITE_BACKEND_URL=http://172.174.201.208:5000
VITE_MS_CLIENT_ID=
VITE_MS_TENANT_ID=common
VITE_MS_REDIRECT_URI=http://172.174.201.208:8080
VITE_MS_GRAPH_SCOPES=User.Read,Calendars.Read

# From Superset UI after login: Application → Cookies → session
SUPERSET_SESSION_COOKIE=

VITE_SUPERSET_URL=http://172.174.201.208:8088
# Iframe always uses the browser URL origin (nginx proxies /embedded)
VITE_SUPERSET_EMBED_SAME_ORIGIN=true
VITE_SUPERSET_EMBED_ID=62ae3ed4-ca6c-49bf-99ed-d02afa453d9f
VITE_SUPERSET_DASHBOARD_ID=10
